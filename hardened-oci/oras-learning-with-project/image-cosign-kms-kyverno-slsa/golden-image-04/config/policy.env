# =============================================================================
# Golden image pipeline configuration
#
#   cp config/policy.env config/policy.local.env   # then edit the local copy
#   ./scripts/golden-image.sh run python
#
# policy.local.env is gitignored and overrides everything here.
# Nothing in this file may ever contain a secret: CIS Docker 4.10, PCI-DSS 8.3.1.
# Credentials come from the runner's OIDC identity or a KMS reference.
# =============================================================================

# --- Registry topology -------------------------------------------------------
# Two namespaces, one registry. mirror/ is quarantine; approved/ is the only
# namespace admission control will accept. Nothing is ever pushed straight to
# approved/ - it can only be reached by promotion from mirror/.
#
# Lab default is the local registry started by `./scripts/golden-image.sh lab-up`.
# Production examples:
#   REGISTRY=registry.internal.bank
#   REGISTRY=ghcr.io/perscoba
#   REGISTRY=harbor.internal.bank/platform
REGISTRY="${REGISTRY:-localhost:5000}"

# --- Signing -----------------------------------------------------------------
# COSIGN_SIGN_MODE: kms | keyless | keyfile
#
#   kms     - production. The private key never leaves the HSM/KMS boundary.
#             FIPS 140-3 validated backend required for FedRAMP and PCI-DSS 3.6.
#   keyless - CI with OIDC. Identity is the workflow, not a key. Good for GitHub
#             Actions; requires a public Rekor or an internal Sigstore stack.
#   keyfile - LAB ONLY. A private key on disk is a finding in any real audit.
COSIGN_SIGN_MODE="${COSIGN_SIGN_MODE:-keyfile}"

# kms:      awskms:///alias/golden-image-signer
#           gcpkms://projects/P/locations/L/keyRings/R/cryptoKeys/K/versions/1
#           azurekms://VAULT.vault.azure.net/golden-image-signer
#           hashivault://golden-image-signer
# keyfile:  path to cosign.key (COSIGN_PASSWORD must be exported separately)
COSIGN_KEY_REF="${COSIGN_KEY_REF:-../cosign-keys/cosign.key}"
COSIGN_PUB_REF="${COSIGN_PUB_REF:-../cosign-keys/cosign.pub}"

# Transparency log. Set to an internal Rekor in an air-gapped estate.
REKOR_URL="${REKOR_URL:-https://rekor.sigstore.dev}"

# TLOG_UPLOAD=false skips the transparency log entirely.
#
# Set false ONLY for local lab runs. Signing with tlog upload enabled writes a
# permanent, public, append-only entry to rekor.sigstore.dev - fine for real
# releases, wrong for throwaway test keys.
#
# In production this must be true, pointed at either the public Rekor or an
# internal one. The log is the tamper-evident record an assessor asks for, and
# without it a stolen key can backdate signatures undetectably.
TLOG_UPLOAD="${TLOG_UPLOAD:-true}"

# --- Evidence ----------------------------------------------------------------
# Local staging directory. CI ships this to WORM storage.
# Retention: SOX 7 years, PCI-DSS 12 months (3 immediately available),
# HIPAA 6 years, FedRAMP 3 years. The programme retains 7 years - the maximum.
EVIDENCE_ROOT="${EVIDENCE_ROOT:-./evidence}"
EVIDENCE_RETENTION_YEARS="${EVIDENCE_RETENTION_YEARS:-7}"

# --- Failure handling --------------------------------------------------------
# A failed gate pages a human and promotes nothing. There is no auto-override.
# An exception requires a documented risk acceptance recorded in the catalog.
PAGE_WEBHOOK="${PAGE_WEBHOOK:-}"          # Slack / PagerDuty / Teams inbound URL
PAGE_SEVERITY="${PAGE_SEVERITY:-high}"

# --- Scanning ----------------------------------------------------------------
TRIVY_SCANNERS="${TRIVY_SCANNERS:-vuln,secret}"
TRIVY_DB_REPOSITORY="${TRIVY_DB_REPOSITORY:-}"   # internal mirror for air-gap
SYFT_FORMATS="${SYFT_FORMATS:-spdx-json cyclonedx-json}"

# --- Promotion tagging -------------------------------------------------------
# Every promoted image carries three references:
#   :YYYY-MM-DD        the dated release, immutable, what Renovate tracks
#   :sha256-<short>    content-addressed convenience alias
#   :current           floating pointer, HUMAN CONVENIENCE ONLY
# Workloads reference the digest. Admission control rejects tag-only refs.
PROMOTE_FLOATING_TAG="${PROMOTE_FLOATING_TAG:-current}"
